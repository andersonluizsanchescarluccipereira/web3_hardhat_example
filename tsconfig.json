{
  "compilerOptions": {
    "target": "ES2020",
    "module": "Node16",               // <-- corrigido
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
